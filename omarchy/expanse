#!/bin/bash
# Expanse as an Omarchy plugin: the bar icon's menu, setting up the Hyprland
# plugin, loading it at login, and taking it all out again.
#
#   expanse menu     the menu, from the bar icon (Omarchy's own menu)
#   expanse setup    build the Hyprland plugin, load it, offer to add its keys
#   expanse load     at login (the plugin's service): load it, rebuilt first
#                    if Hyprland or Expanse changed since it was built
#   expanse remove   unload it, offer to take its keys out, remove the plugin
#   expanse layout [back]
#                    SUPER + L: the workspace's layout, through tiling,
#                    scrolling, floating and Expanse (Omarchy's, plus Expanse)
#   expanse here [on|off]       Expanse on this workspace, or its default back
#   expanse everywhere [on|off] Expanse as the layout of every workspace
#                               without one of its own
#
# The Hyprland plugin is built from this checkout, the code you installed,
# into ~/.local/share/expanse-omarchy; nothing is downloaded.

set -uo pipefail

ID="io.github.invig.expanse"
HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
SELF="$HERE/omarchy/expanse"
BUILD="${XDG_DATA_HOME:-$HOME/.local/share}/expanse-omarchy"
SO="$BUILD/expanse.so"
STAMP="$BUILD/built-for"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/expanse"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
KEYS="$HERE/examples/expanse.lua"
KEYS_LINE="dofile(\"$KEYS\")"
KEYS_NOTE="-- Expanse (its Omarchy plugin): keys and window rule"

state() {
  local out
  out=$(hyprctl expanse 2>/dev/null)
  [[ $out == "{"* ]] && printf '%s' "$out"
}

# Which file Expanse is running from, if it's running.
loaded_from() {
  state | jq -r '.library // empty'
}

# What a build is for: this Hyprland, and Expanse's code as it is in this
# checkout (an update that only changes its docs needs no rebuild).
identity() {
  local hyprland expanse
  hyprland=$(hyprctl version -j 2>/dev/null | jq -r '.commit // empty')
  expanse=$(git -C "$HERE" rev-parse HEAD:src HEAD:Makefile 2>/dev/null | tr '\n' ' ')
  [[ -n $expanse ]] || expanse=$(jq -r '.version' "$HERE/manifest.json")
  echo "$hyprland $expanse"
}

build() {
  mkdir -p "$BUILD"
  make -C "$HERE" OUT="$SO" || return 1
  identity >"$STAMP"
}

# Running from this build, as built now. One loaded another way (hyprpm, a
# build of your own) is left alone.
load_build() {
  local from
  from=$(loaded_from)
  [[ -n $from && $from != "$SO" ]] && return 0
  if [[ $from == "$SO" ]]; then
    [[ ${1:-} == fresh ]] || return 0
    hyprctl plugin unload "$SO" >/dev/null
  fi
  hyprctl plugin load "$SO" >/dev/null
}

cmd_load() {
  # Not set up yet: the bar icon offers setup.
  [[ -f $SO ]] || exit 0
  if [[ $(cat "$STAMP" 2>/dev/null) != "$(identity)" ]]; then
    if ! build >"$BUILD/build.log" 2>&1; then
      notify-send "Expanse" "Couldn't rebuild Expanse for this Hyprland: Set up Expanse, from its icon in the bar, tries again and shows why." 2>/dev/null
      exit 1
    fi
    load_build fresh
  else
    load_build
  fi
}

ask() {
  if command -v gum >/dev/null; then
    gum confirm "$1"
  else
    local answer
    read -r -p "$1 [y/N] " answer
    [[ $answer == [yY]* ]]
  fi
}

cmd_setup() {
  echo "Setting up Expanse."
  echo
  local missing=()
  for tool in g++ make pkg-config jq; do
    command -v "$tool" >/dev/null || missing+=("$tool")
  done
  if (( ${#missing[@]} )) || ! pkg-config --exists hyprland; then
    echo "Building Expanse needs a compiler, make, pkg-config, jq and Hyprland's headers."
    echo "Omarchy has them all; elsewhere, install base-devel, pkgconf, jq and hyprland, then set up again."
    exit 1
  fi

  echo "Building it for Hyprland $(hyprctl version -j | jq -r '.tag // .version'), which takes a minute or two."
  echo
  if ! build; then
    echo
    echo "The build failed; the output is above. Please report it at"
    echo "https://github.com/invig/expanse-omarchy/issues"
    exit 1
  fi
  load_build fresh
  if [[ -z $(state) ]]; then
    echo
    echo "Built, but Hyprland didn't load it. Try: hyprctl plugin load $SO"
    exit 1
  fi
  echo
  echo "Expanse is running."
  echo

  if grep -qxF "$KEYS_LINE" "$CONFIG" 2>/dev/null; then
    echo "Its keys are already in $CONFIG."
  else
    cat <<EOF
Expanse's keys come from one line at the end of $CONFIG, which loads
$KEYS:

  Alt + \`          zoom out to every window, and back
  Super + arrows   hop to the nearest window that way (in Expanse; Omarchy's
                   focus keys on other layouts)
  Ctrl + Alt + C   centre the window you're in
  Alt + Shift + \`  auto-centre on or off
  Super + L        cycle the workspace's layout: tiling, scrolling, floating,
                   Expanse (Super + Alt + L back)

The line:

  $KEYS_LINE

EOF
    if ask "Add it to hyprland.lua?"; then
      printf '\n%s\n%s\n' "$KEYS_NOTE" "$KEYS_LINE" >>"$CONFIG"
      hyprctl reload >/dev/null
      echo "Added."
    else
      echo "Left as it is. Add the line yourself whenever you like."
    fi
  fi
  echo
  if [[ $(omarchy-hyprland-workspace-layout-default) == expanse ]]; then
    echo "Expanse is the layout of every workspace that doesn't have one of its own."
  else
    echo "Expanse is a workspace layout, next to Omarchy's tiling, scrolling and"
    echo "floating: Super + L cycles a workspace through them. It can be the layout of"
    echo "every workspace (each can still be switched with Super + L), or only of the"
    echo "ones you switch to it."
    echo
    if command -v gum >/dev/null; then
      local choice
      choice=$(gum choose --header "Use Expanse on" "Every workspace" "Only the ones I switch to it") || choice=""
      [[ $choice == "Every workspace" ]] && cmd_everywhere on
    elif ask "Use Expanse on every workspace?"; then
      cmd_everywhere on
    fi
    echo
  fi
  if [[ $(omarchy-hyprland-workspace-layout-current) == expanse ]]; then
    echo "Rest the pointer in a bottom corner of the screen, or press Alt + \`, to zoom out."
  elif grep -qxF "$KEYS_LINE" "$CONFIG" 2>/dev/null; then
    echo "Press Super + L until it says Expanse to make a workspace a canvas, then rest"
    echo "the pointer in a bottom corner of the screen, or press Alt + \`, to zoom out."
  else
    echo "Pick Use Expanse Here from Expanse's icon in the bar to make a workspace a"
    echo "canvas, then rest the pointer in a bottom corner of the screen to zoom out."
  fi
  echo "Expanse's icon in the bar has the rest. It loads at every login, and rebuilds"
  echo "itself after Hyprland updates."
}

cmd_remove() {
  echo "Removing Expanse. Your windows go back where Hyprland had them."
  echo
  ask "Remove Expanse?" || exit 130
  leave_modes
  [[ $(loaded_from) == "$SO" ]] && hyprctl plugin unload "$SO" >/dev/null
  if grep -qxF "$KEYS_LINE" "$CONFIG" 2>/dev/null && ask "Take Expanse's line out of hyprland.lua?"; then
    local kept
    kept=$(grep -vxF -e "$KEYS_LINE" -e "$KEYS_NOTE" "$CONFIG")
    printf '%s\n' "$kept" >"$CONFIG"
    hyprctl reload >/dev/null
  fi
  rm -rf "$BUILD"
  if [[ -d $STATE ]] && ask "Delete the layouts Expanse saved too ($STATE)?"; then
    rm -rf "$STATE"
  fi
  omarchy-plugin-remove "$ID" --yes
  echo
  echo "Expanse is removed."
}

# --- Expanse as a workspace mode, in Omarchy's own: its mode files (one per
# workspace, and the default), its notification, its bar and dock refreshed.

MODES="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts"

notify_layout() {
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layout-notification"
  local last id
  [[ -r $state ]] && read -r last <"$state"
  if id=$(omarchy-notification-send -p -r "${last:-0}" -g 󱂬 "$1") && [[ $id =~ ^[0-9]+$ ]]; then
    mkdir -p "$(dirname "$state")" && printf '%s\n' "$id" >"$state"
  fi
}

mode_message() {
  case $1 in
    expanse) echo "Workspace layout set to Expanse" ;;
    dwindle) omarchy-i18n layout.workspaceTiling ;;
    scrolling) omarchy-i18n layout.workspaceScrolling ;;
    *) omarchy-i18n layout.workspaceFloating ;;
  esac
}

# A workspace's mode, from the one it has now, saved as its own unless it's the
# default.
switch_mode() {
  local workspace=$1 mode=$2 current=$3
  # Between Omarchy's floating and Expanse, windows stay where they are: the
  # mode taking over adopts the windows the other floated out of tiling, to
  # tile them again when it ends.
  if [[ $mode == expanse && $current == floating ]]; then
    hyprctl expanse adopt "$workspace" >/dev/null
    local address
    for address in $(hyprctl clients -j | jq -r --arg ws "$workspace" \
      '.[] | select((.workspace.id | tostring) == $ws and .floating and any(.tags[]?; startswith("omarchy-mode-floated"))) | .address'); do
      hyprctl dispatch "hl.dsp.window.tag({ tag = \"-omarchy-mode-floated\", window = \"address:$address\" })" >/dev/null
    done
  elif [[ $mode == floating && $current == expanse ]]; then
    local released address
    released=$(hyprctl expanse release "$workspace")
    # Floating keeps the layout the workspace had, and Expanse's would keep the
    # canvas on: tiling first (with the windows not yet Omarchy's, or it would
    # tile them on the way).
    hyprctl eval "o.workspace_mode({ workspace = \"$workspace\", mode = \"dwindle\" })" >/dev/null 2>&1
    for address in $released; do
      hyprctl dispatch "hl.dsp.window.tag({ tag = \"+omarchy-mode-floated\", window = \"address:$address\" })" >/dev/null
    done
  fi
  local apply="o.workspace_mode({ workspace = \"$workspace\", mode = \"$mode\" })"
  hyprctl eval "$apply" >/dev/null 2>&1 || return 1
  if [[ $mode == "$(omarchy-hyprland-workspace-layout-default)" ]]; then
    rm -f "$MODES/$workspace.lua"
  else
    mkdir -p "$MODES" && printf '%s\n' "$apply" >"$MODES/$workspace.lua"
  fi
}

# Omarchy's bar and dock show each workspace's mode; floating's titlebars load
# with the config, as Omarchy's own cycle does it.
modes_changed() {
  omarchy-shell -q omarchy.workspaces refresh
  omarchy-shell -q omarchy.dock refresh
  if [[ ${1:-} == floating ]] && ! hyprctl plugin list -j 2>/dev/null | jq -e 'any(.[]?; .name == "hyprbars")' >/dev/null 2>&1; then
    hyprctl reload >/dev/null
  fi
}

# The active workspace's mode.
set_mode() {
  local mode=$1 workspace
  workspace=$(hyprctl activeworkspace -j | jq -r '.id')
  [[ $workspace =~ ^[0-9]+$ ]] || return 1
  if ! switch_mode "$workspace" "$mode" "$(omarchy-hyprland-workspace-layout-current)"; then
    notify_layout "$(omarchy-i18n layout.needsReload)"
    return 1
  fi
  notify_layout "$(mode_message "$mode")"
  modes_changed "$mode"
}

cmd_layout() {
  # Without Expanse running, Omarchy's own cycle.
  if [[ -z $(state) ]]; then
    exec omarchy-hyprland-workspace-layout-toggle "$@"
  fi
  local current next
  current=$(omarchy-hyprland-workspace-layout-current)
  if [[ ${1:-} == back ]]; then
    case $current in
      dwindle) next=expanse ;;
      expanse) next=floating ;;
      floating) next=scrolling ;;
      *) next=dwindle ;;
    esac
  else
    case $current in
      dwindle) next=scrolling ;;
      scrolling) next=floating ;;
      floating) next=expanse ;;
      *) next=dwindle ;;
    esac
  fi
  set_mode "$next"
}

cmd_here() {
  case ${1:-on} in
    on) set_mode expanse ;;
    *)
      local default
      default=$(omarchy-hyprland-workspace-layout-default)
      [[ $default == expanse ]] && default=dwindle
      set_mode "$default"
      ;;
  esac
}

# Every workspace: Omarchy's default layout (which its own command keeps to
# tiling, scrolling and floating), and the workspaces there are now, each still
# free to take another with Super + L. The default it replaces is kept, to go
# back to.
BEFORE="$STATE/default-before.lua"

# Each workspace there is, with its mode: read before the default changes, as
# Omarchy reads a workspace without one of its own from the default.
workspace_modes() {
  local workspace
  for workspace in $(hyprctl workspaces -j | jq -r '.[] | select(.id >= 1) | .id'); do
    echo "$workspace $(omarchy-hyprland-workspace-layout-current "$workspace")"
  done
}

cmd_everywhere() {
  local before workspace current
  before=$(workspace_modes)
  if [[ ${1:-on} == on ]]; then
    [[ $(omarchy-hyprland-workspace-layout-default) == expanse ]] && return 0
    mkdir -p "$STATE"
    if [[ -f $MODES/default.lua ]]; then cp "$MODES/default.lua" "$BEFORE"; else rm -f "$BEFORE"; fi
    # Each workspace first, from the mode it has, so its windows stay put.
    while read -r workspace current; do
      [[ -n $workspace ]] && switch_mode "$workspace" expanse "$current"
    done <<<"$before"
    mkdir -p "$MODES"
    printf 'o.workspace_mode({ default = "expanse" })\n' >"$MODES/default.lua"
    hyprctl eval 'o.workspace_mode({ default = "expanse" })' >/dev/null 2>&1
    rm -f "$MODES"/[0-9]*.lua
    notify_layout "Default layout set to Expanse"
    modes_changed
  else
    [[ $(omarchy-hyprland-workspace-layout-default) == expanse ]] || return 0
    # The default from before, or (without one saved) Hyprland's own from the
    # config, which takes a reload to read again.
    local default=""
    [[ -f $BEFORE ]] && default=$(sed -n 's/.*default = "\([a-z]*\)".*/\1/p' "$BEFORE")
    local switched=()
    if [[ -n $default ]]; then
      while read -r workspace current; do
        if [[ $current == expanse && ! -f $MODES/$workspace.lua ]]; then
          switch_mode "$workspace" "$default" expanse && switched+=("$workspace")
        fi
      done <<<"$before"
      mv "$BEFORE" "$MODES/default.lua"
      hyprctl eval "o.workspace_mode({ default = \"$default\" })" >/dev/null 2>&1
      for workspace in "${switched[@]}"; do rm -f "$MODES/$workspace.lua"; done
    else
      rm -f "$MODES/default.lua" "$BEFORE"
      hyprctl reload >/dev/null
      default=$(omarchy-hyprland-workspace-layout-default)
    fi
    case $default in
      scrolling) notify_layout "$(omarchy-i18n layout.defaultScrolling)" ;;
      floating) notify_layout "$(omarchy-i18n layout.defaultFloating)" ;;
      *) notify_layout "$(omarchy-i18n layout.defaultTiling)" ;;
    esac
    modes_changed "$default"
  fi
}

# Out of Omarchy's modes, before the layout goes with the plugin: every
# workspace back to the default it had.
leave_modes() {
  cmd_everywhere off
  local workspace current
  while read -r workspace current; do
    [[ $current == expanse ]] && switch_mode "$workspace" "$(omarchy-hyprland-workspace-layout-default)" expanse
  done <<<"$(workspace_modes)"
  local file
  for file in "$MODES"/[0-9]*.lua; do
    [[ -f $file ]] && grep -q 'mode = "expanse"' "$file" && rm -f "$file"
  done
  modes_changed
}

# --- The menu: Omarchy's own, with Expanse's rows. A row is
# "<icon><TAB><label>[<TAB><subtext>]"; the label comes back.

# Wide enough for "Centre Current Window" and its subtexts.
choose() {
  omarchy-menu-select "$@" -- --width 380 | cut -f1
}

on_off() {
  [[ $1 == true ]] && echo "On" || echo "Off"
}

in_terminal() {
  omarchy-launch-floating-terminal-with-presentation "$*"
}

restore_layout_menu() {
  local snapshots names=("Newest" "Earlier" "Earliest") rows=()
  snapshots=$(hyprctl expanse layout 2>/dev/null)
  while IFS=$'\t' read -r index ago at; do
    [[ -n $index && -n ${names[$index]:-} ]] && rows+=($'\U000F02DA\t'"${names[$index]}"$'\t'"${ago^}, $at")
  done < <(jq -r '.[] | [.snapshot, .ago, .at] | @tsv' <<<"$snapshots" 2>/dev/null)
  if (( ${#rows[@]} == 0 )); then
    choose "Restore Layout" $'\U000F02DA\tNo earlier layouts yet\tOne is kept when the layout changes, 15 minutes apart' >/dev/null
    return
  fi
  local picked
  picked=$(choose "Restore Layout" "${rows[@]}") || return
  for index in "${!names[@]}"; do
    [[ ${names[$index]} == "$picked" ]] && hyprctl expanse layout "$index" >/dev/null
  done
}

hot_corner_menu() {
  local current names=(bottom all top_left top_right bottom_left bottom_right off)
  local labels=("Bottom" "All" "Top Left" "Top Right" "Bottom Left" "Bottom Right" "Off")
  current=$(state | jq -r '.hotCorner // empty')
  local rows=()
  for i in "${!names[@]}"; do
    rows+=($'\t'"${labels[$i]}$([[ ${names[$i]} == "$current" ]] && printf '\tCurrent')")
  done
  local picked
  picked=$(choose "Hot Corner" "${rows[@]}") || return
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$picked" ]] && hyprctl expanse corner "${names[$i]}" >/dev/null
  done
}

cmd_menu() {
  local now
  now=$(state)
  if [[ -z $now ]]; then
    local picked
    picked=$(choose "Expanse" \
      $'\tSet up Expanse\tBuild its Hyprland plugin, then add its keys' \
      $'\tRemove Expanse') || exit 0
    case $picked in
      "Set up Expanse") in_terminal "$SELF" setup ;;
      "Remove Expanse") in_terminal "$SELF" remove ;;
    esac
    exit 0
  fi

  local newest corner paused mode everywhere
  newest=$(hyprctl expanse layout 2>/dev/null | jq -r '.[0].ago // "none yet"')
  corner=$(jq -r '.hotCorner' <<<"$now" | sed 's/_/ /; s/\b\(.\)/\u\1/g')
  paused=$(jq -r .paused <<<"$now")
  mode=$(omarchy-hyprland-workspace-layout-current)
  everywhere=$([[ $(omarchy-hyprland-workspace-layout-default) == expanse ]] && echo true || echo false)
  local picked
  if [[ $mode != expanse ]]; then
    # A workspace with another layout: Expanse isn't a canvas here.
    picked=$(choose "Expanse" \
      $'\tUse Expanse Here\tThis workspace as a canvas (Super + L)' \
      $'\tEvery Workspace\t'"$(on_off "$everywhere")" \
      $'\tHot Corner\t'"$corner" \
      $'\tShortcuts' \
      $'\tRemove Expanse') || exit 0
    case $picked in
      "Use Expanse Here") cmd_here on ;;
      "Every Workspace") cmd_everywhere "$([[ $everywhere == true ]] && echo off || echo on)" ;;
      "Hot Corner") hot_corner_menu ;;
      "Shortcuts") in_terminal hyprctl expanse keys ;;
      "Remove Expanse") in_terminal "$SELF" remove ;;
    esac
    exit 0
  fi
  picked=$(choose "Expanse" \
    $'\tZoom Out' \
    $'\tTidy Up' \
    $'\uf192\tCentre Current Window' \
    $'\U000F02DA\tRestore Layout\t'"Newest: $newest" \
    $'\tRestore All Windows\tEvery window back into view' \
    $'\tAuto-Centre\t'"$(on_off "$(jq -r .autoCentre <<<"$now")")" \
    $'\tDesktop Picture\t'"$(on_off "$(jq -r .wallpaper <<<"$now")")" \
    $'\t'"$([[ $paused == true ]] && echo Resume || echo Pause)"$'\tWindows back where they were before the canvas' \
    $'\tHot Corner\t'"$corner" \
    $'\tStop Using Expanse Here\tThis workspace back to tiling (Super + L cycles)' \
    $'\tEvery Workspace\t'"$(on_off "$everywhere")" \
    $'\tShortcuts' \
    $'\tRemove Expanse') || exit 0

  case $picked in
    "Stop Using Expanse Here") cmd_here off ;;
    "Every Workspace") cmd_everywhere "$([[ $everywhere == true ]] && echo off || echo on)" ;;
    "Zoom Out") hyprctl expanse toggle >/dev/null ;;
    "Tidy Up") hyprctl expanse tidy >/dev/null ;;
    "Centre Current Window") hyprctl expanse centre >/dev/null ;;
    "Restore Layout") restore_layout_menu ;;
    "Restore All Windows") hyprctl expanse restore >/dev/null ;;
    "Auto-Centre") hyprctl expanse autocentre toggle >/dev/null ;;
    "Desktop Picture") hyprctl expanse wallpaper toggle >/dev/null ;;
    "Pause") hyprctl expanse pause >/dev/null ;;
    "Resume") hyprctl expanse resume >/dev/null ;;
    "Hot Corner") hot_corner_menu ;;
    "Shortcuts") in_terminal hyprctl expanse keys ;;
    "Remove Expanse") in_terminal "$SELF" remove ;;
  esac
}

case ${1:-} in
  layout) shift; cmd_layout "$@" ;;
  here) shift; cmd_here "$@" ;;
  everywhere) shift; cmd_everywhere "$@" ;;
  menu) cmd_menu ;;
  setup) cmd_setup ;;
  load) cmd_load ;;
  remove) cmd_remove ;;
  *)
    sed -n '2,10p' "$SELF"
    exit 1
    ;;
esac
